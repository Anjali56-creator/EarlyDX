# ── EarlyDX .gitignore ───────────────────────────────────────────────

# Data — never commit raw or processed healthcare datasets, but keep the
# directory skeleton and all metadata / registries.
data/raw/*/*
data/processed/*/*
!data/raw/*/.gitkeep
!data/processed/*/.gitkeep
data/**/*.csv
data/**/*.parquet
data/**/*.xlsx
data/**/*.data
data/**/*.zip

# Model artifacts: regenerated by training, so experimental/candidate runs
# stay untracked by default — but the artifacts backing an "active" entry in
# models/model_registry.json ARE committed (production/Render loads them
# straight from the repo, no training step at deploy time). Ignore, then
# explicitly allow the served ones.
ml/*/artifacts/*
!ml/*/artifacts/.gitkeep
models/*.pkl
models/*.onnx
*.pkl
*.onnx
models/*.joblib
!models/diabetes-v1.joblib
!models/breast_cancer-v1.joblib
!models/heart_disease-v1.joblib
!models/heart_failure-v1.joblib
!models/kidney_disease-v1.joblib
!models/liver_disease-v1.joblib
!models/maternal_health-v1.joblib
!models/obesity-v1.joblib
!models/parkinsons-v1.joblib
!models/thyroid-v1.joblib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
*.local

# Env / secrets
.env
.env.*
!.env.example

# Local dev database
earlydx.db
*.db

# OS / editor
.DS_Store
Thumbs.db
