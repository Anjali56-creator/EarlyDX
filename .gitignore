# ── EarlyDX .gitignore ───────────────────────────────────────────────

# Data — never commit raw or processed healthcare datasets, but keep the
# directory skeleton and all metadata / registries.
data/raw/*/*
data/processed/*/*
!data/raw/*/.gitkeep
!data/processed/*/.gitkeep
data/**/*.csv
data/**/*.parquet
data/**/*.xlsx
data/**/*.data
data/**/*.zip

# Model artifacts (large, regenerated by training)
ml/*/artifacts/*
!ml/*/artifacts/.gitkeep
models/*.pkl
models/*.joblib
models/*.onnx
*.pkl
*.joblib
*.onnx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
frontend/build/
*.local

# Env / secrets
.env
.env.*
!.env.example

# Local dev database
earlydx.db
*.db

# OS / editor
.DS_Store
Thumbs.db
