# Copy to .env (never commit .env). Values below are safe local dev defaults.
EARLYDX_ENV=development
EARLYDX_LOG_LEVEL=INFO

# Postgres (docker-compose only; these do not feed the backend directly)
POSTGRES_USER=earlydx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=earlydx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The backend's Settings has env_prefix="EARLYDX_", so the URL it actually
# reads MUST be named EARLYDX_DATABASE_URL, not DATABASE_URL. Optional: if
# unset, the backend falls back to a local SQLite file and still serves
# predictions -- it just won't persist assessment history.
EARLYDX_DATABASE_URL=postgresql+psycopg://earlydx:change-me-locally@localhost:5432/earlydx

# Backend
EARLYDX_API_HOST=0.0.0.0
EARLYDX_API_PORT=8000
EARLYDX_CORS_ORIGINS=http://localhost:5173

# Paths (repo-relative; override only if running outside the repo)
EARLYDX_MODELS_DIR=models
EARLYDX_DATA_DIR=data
