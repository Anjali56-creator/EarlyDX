# Copy to .env (never commit .env). Values below are safe local dev defaults.
EARLYDX_ENV=development
EARLYDX_LOG_LEVEL=INFO

# Postgres
POSTGRES_USER=earlydx
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=earlydx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL used by the backend (overrides the parts above if set)
DATABASE_URL=postgresql+psycopg://earlydx:change-me-locally@localhost:5432/earlydx

# Backend
EARLYDX_API_HOST=0.0.0.0
EARLYDX_API_PORT=8000
EARLYDX_CORS_ORIGINS=http://localhost:5173

# Paths (repo-relative; override only if running outside the repo)
EARLYDX_MODELS_DIR=models
EARLYDX_DATA_DIR=data
